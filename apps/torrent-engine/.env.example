NODE_ENV=development
PORT=9000
LOG_LEVEL=debug

# Redis (fila Bull + pub/sub para backend Go)
REDIS_URL=redis://redis:6379

# Backend Go — para enviar webhooks de metadata pronta
API_URL=http://api:8080
API_WEBHOOK_SECRET=dev-webhook-secret-change-in-prod

# Armazenamento local de torrents
TORRENT_DOWNLOAD_PATH=/data/torrents

# Limites
MAX_TORRENTS=50
MAX_DISK_GB=20
MAX_CONNS_PER_TORRENT=55
