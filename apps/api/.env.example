# ─── Core ────────────────────────────────────────────────────────────────────
ENV=development
PORT=8080
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://torrentleaf:secret@postgres:5432/torrentleaf?sslmode=disable

# ─── Cache / Fila ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Torrent Engine ──────────────────────────────────────────────────────────
TORRENT_ENGINE_URL=http://torrent-engine:9000

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Gere valores aleatórios com pelo menos 32 caracteres em produção.
JWT_SECRET=dev-jwt-secret-change-in-production-32c
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod-32c

# ─── MinIO (S3-compatible) ───────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=torrentleaf
MINIO_SECRET_KEY=secretsecret
