# TorrentLeaf — example environment for docker-compose.dev.yml
# Copy to `.env` and adjust. Compose substitutes ${VAR} from this file.

# ─── Host tooling ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://torrentleaf:secret@localhost:5432/torrentleaf
# Personal access token used by dev scripts / MCP tooling (optional).
GITHUB_TOKEN=
# Optional pre-issued JWT for local API testing (optional).
DEV_JWT_TOKEN=

# ─── Torrent engine ───────────────────────────────────────────────────────────
# Host directory bind-mounted into the engine at /data/torrents. Torrents land
# here on your real filesystem. Per-user "download path" settings are validated
# subfolders under this dir. Must be writable by the container user. See ADR 006.
TORRENTLEAF_DATA_DIR=./data/torrents
